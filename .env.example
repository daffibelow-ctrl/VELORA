NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://postgres:password@localhost:5432/velora
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=1h
CORS_ORIGIN=https://your-domain.example

# Real payment provider: Xendit xenPlatform
PAYMENT_PROVIDER=xendit
XENDIT_SECRET_KEY=xnd_production_REPLACE_ME
XENDIT_WEBHOOK_TOKEN=REPLACE_ME
XENDIT_API_VERSION=2024-11-11

# Platform fee, example only
PLATFORM_FEE_PERCENT=5

# Never put these secrets in frontend JavaScript.
